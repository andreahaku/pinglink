{
  "name": "pinglink",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "bin": {
    "pinglink": "./bin/pinglink"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outfile=dist/cli.js --target=bun --minify --external=blessed --external=term.js --external=pty.js --external=ink --external=react && bun build src/index.ts --outfile=dist/index.js --target=bun --minify --external=blessed --external=term.js --external=pty.js --external=ink --external=react",
    "dev": "bun run src/cli.ts",
    "dev:watch": "bun run --watch src/cli.ts",
    "start": "bun run src/cli.ts",
    "ping": "bun run src/cli.ts",
    "ping:google": "bun run src/cli.ts 8.8.8.8",
    "ping:cloudflare": "bun run src/cli.ts 1.1.1.1",
    "ping:demo": "bun run src/cli.ts 8.8.8.8 --count 20 --interval 500",
    "ping:quiet": "bun run src/cli.ts --quiet",
    "ping:detailed": "bun run src/cli.ts --detailed",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/**/*.ts",
    "type-check": "bun run tsc --noEmit",
    "clean": "rm -rf dist/",
    "prepare": "bun run build",
    "install-global": "bun run build && bun link"
  },
  "keywords": [
    "ping",
    "network",
    "monitoring",
    "cli",
    "terminal"
  ],
  "author": "",
  "license": "ISC",
  "description": "Visual Ping Monitor CLI Tool with real-time terminal interface",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.13",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@types/blessed": "^0.1.25",
    "blessed": "^0.1.81",
    "chalk": "^5.6.0",
    "cli-cursor": "^5.0.0",
    "commander": "^14.0.0",
    "ink": "^6.7.0",
    "react": "^19.2.4"
  }
}
